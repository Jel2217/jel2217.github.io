// Cloudflare Workers config. The site is static: Workers Builds runs
// `bundle exec jekyll build`, then `npx wrangler deploy` uploads _site.
{
  "name": "jel2217-github-io",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Lets other branches get preview links (`wrangler preview`). Empty means
  // previews use the same settings as the live site.
  "previews": {}
}
